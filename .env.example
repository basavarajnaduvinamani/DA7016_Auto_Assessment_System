# Copy to .env. Never commit real keys.
AUTOASSESS_CACHE_DIR=.cache
# text: typed .txt sheets | indic-precomputed: IndicOCR JSON made in the Colab notebook
# indic-local: IndicOCR open weights in-process (GPU) | vision: a vision LLM | bodhan: hosted API (week 5)
AUTOASSESS_OCR_PROVIDER=text
AUTOASSESS_OCR_JSON_DIR=ocr_json
AUTOASSESS_INDIC_OCR_REPO=            # local snapshot of bodhan-ai/indic-ocr; empty = download
AUTOASSESS_VISION_MODEL=              # for the vision OCR baseline

# LLM for grading. AUTOASSESS_LLM_PROVIDER picks one; left empty, it is the first with a key (Gemini first).
#   gemini:     free tier for development. Key from aistudio.google.com/apikey
#               (a consumer Gemini subscription does not include API access).
#   openrouter: the course's $20 key, for evaluation runs and the demo. Check credit: autoassess doctor
#   custom:     any OpenAI-compatible endpoint, e.g. Ollama at http://localhost:11434/v1 (free, local)
AUTOASSESS_LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BUDGET_USD=18              # course key has $20; paid calls stop here (exact cost from each response)
AUTOASSESS_LLM_BASE_URL=              # custom only
AUTOASSESS_LLM_API_KEY=               # custom key (also read as the Gemini key)
AUTOASSESS_LLM_MODEL=                 # overrides the model for any provider
AUTOASSESS_CRITIC_MODEL=              # optional; a different model makes a stronger critic

BODHAN_API_KEY=                       # from console.bodhan.ai (coupon credits)
BODHAN_OCR_API_KEY=                   # only if Bodhan gave a separate key per model;
BODHAN_TRANSLATE_API_KEY=             #   each falls back to BODHAN_API_KEY
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_BUDGET_INR=100                 # course credit is Rs 110 (~500 pages); paid calls stop here, cached calls are free
