# Copy to .env. Never commit real keys.
AUTOASSESS_CACHE_DIR=.cache
AUTOASSESS_OCR_PROVIDER=text          # text | bodhan (week 5)

# Any OpenAI-compatible chat endpoint. Examples:
#   OpenRouter: https://openrouter.ai/api/v1   (key from openrouter.ai)
#   Ollama:     http://localhost:11434/v1      (free, local; no key)
AUTOASSESS_LLM_BASE_URL=https://openrouter.ai/api/v1
AUTOASSESS_LLM_MODEL=
AUTOASSESS_CRITIC_MODEL=              # optional; a different model makes a stronger critic
AUTOASSESS_LLM_API_KEY=

BODHAN_API_KEY=                       # leave empty until week 5
BODHAN_BASE_URL=https://api.bodhan.ai/v1
